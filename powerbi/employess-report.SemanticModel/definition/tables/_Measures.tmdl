table _Measures
	lineageTag: 239e3b42-74ad-4994-86fb-cf55a22abeef

	measure 'Actual Monthly Payroll EGP' = SUM('Dim_Employee'[الراتب الأساسي])
		formatString: "AED"#,0.###############;-"AED"#,0.###############;"AED"#,0.###############
		lineageTag: 64b77373-df9f-4ead-b1b3-dbed2d1ea06c

		annotation PBI_FormatHint = {"currencyCulture":"en-AE"}

	measure 'Allocated Monthly Salary Budget EGP' = DIVIDE(SUM('Fact_DepartmentBudget'[Budget_EGP]), 3, 0)
		formatString: "AED"#,0.###############;-"AED"#,0.###############;"AED"#,0.###############
		lineageTag: cd9e3c11-d9a9-4ed3-aacc-e16a6e80cfef

		annotation PBI_FormatHint = {"currencyCulture":"en-AE"}

	measure 'Budget Variance EGP' =
			
			VAR ActualPayroll = [Actual Monthly Payroll EGP]
			VAR MonthlyBudget = [Allocated Monthly Salary Budget EGP]
			RETURN
			IF(
			    NOT(ISBLANK(ActualPayroll)) && NOT(ISBLANK(MonthlyBudget)),
			    ActualPayroll - MonthlyBudget,
			    BLANK()
			)
		formatString: "AED"#,0.###############;-"AED"#,0.###############;"AED"#,0.###############
		lineageTag: 006ae508-4ca9-4d02-8aed-6f43d5a27923

		annotation PBI_FormatHint = {"currencyCulture":"en-AE"}

	measure 'Budget Variance Pct' =
			
			DIVIDE([Budget Variance EGP], [Allocated Monthly Salary Budget EGP], BLANK())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6a9954db-d5ef-49f0-843e-9c693874867e

	measure 'Payroll Burn Rate Pct' =
			
			DIVIDE([Actual Monthly Payroll EGP], [Allocated Monthly Salary Budget EGP], BLANK())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5e17b2e2-b598-4440-8bc7-fd076545f1fc

	measure 'Budgeted Target Headcount' =
			
			SUM('Fact_DepartmentBudget'[Headcount])
		formatString: 0
		lineageTag: 3fad302c-94ad-4fca-97ab-fceb0b4c4333

	measure 'Actual Headcount' =
			
			COUNTROWS('Dim_Employee')
		formatString: 0
		lineageTag: 765c0c00-33d5-4d90-ab4d-3ca8c5d9df4f

	measure 'Headcount Variance' =
			
			VAR ActualHC = [Actual Headcount]
			VAR TargetHC = [Budgeted Target Headcount]
			RETURN
			    IF(NOT(ISBLANK(TargetHC)), ActualHC - TargetHC, BLANK())
		formatString: 0
		lineageTag: 04430bf0-80e6-436f-991c-7084c5aba6a8

	measure 'Headcount Variance Pct' =
			
			DIVIDE([Headcount Variance], [Budgeted Target Headcount], BLANK())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: cdfe0ee3-7047-4d40-b8be-0ed89ad953db

	measure 'Headcount Fulfillment Pct' =
			
			DIVIDE([Actual Headcount], [Budgeted Target Headcount], BLANK())
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 084634bc-330b-4fa5-bac9-8aa25e7dd658

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

