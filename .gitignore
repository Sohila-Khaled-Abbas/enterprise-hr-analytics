*.pbix

# Python & Environments
venv/
.env
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/


# Data Directories
# Keep master seed source files and enriched datasets, ignore ephemeral artifacts
data/raw/*
!data/raw/.gitkeep
!data/raw/employees_data_7000.txt
