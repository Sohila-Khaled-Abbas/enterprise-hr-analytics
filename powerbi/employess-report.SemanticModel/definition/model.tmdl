model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: ar-EG
	valueFilterBehavior: independent
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Raw_Data

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions_Tables

	annotation PBI_QueryGroupOrder = 1

queryGroup Fact_Tables

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["employees_data_7000","Exit_Attrition_Records","Dim_Employee","Dim_Department"]

annotation PBI_ProTooling = ["DevMode"]

ref table Dim_Employee
ref table Dim_Department

ref cultureInfo en-US

