!data/raw/lms_curriculum_catalog.csv
!data/raw/client_projects_tasks.csv
!data/raw/client_projects_tasks.json
!data/raw/dim_currency_rates.csv
!data/raw/exit_attrition_records.csv

data/processed/*
!data/processed/.gitkeep
!data/processed/Dim_CurrencyRates.csv

