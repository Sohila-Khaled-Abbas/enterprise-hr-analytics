# ──────────────────────────────────────────────────────────────────
# Enterprise Human Capital & Operational Efficiency Diagnostics
# Database Connection Configuration (.env.example)
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows)
# ──────────────────────────────────────────────────────────────────

# Microsoft SQL Server (T-SQL) Connection
DB_DRIVER={ODBC Driver 17 for SQL Server}
DB_SERVER=localhost\SQLEXPRESS          # Replace with your SQL Server instance
DB_DATABASE=EnterpriseHR_DWH

# Authentication
# Option A: Windows Authentication (leave DB_USER and DB_PASS empty)
# Option B: SQL Server Authentication (fill in both)
DB_USER=
DB_PASS=

# Data Paths (relative to project root)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed

# Logging
LOG_LEVEL=INFO
